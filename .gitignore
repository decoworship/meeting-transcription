# Environment variables (contains secrets)
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Test/lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS noise
.DS_Store
Thumbs.db

# Claude Code local settings (keep settings.json if/when added)
.claude/settings.local.json

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Audio extraction temp files
*.wav

# Runtime user data: per-user config, project list, history,
# voice fingerprints, and HuggingFace model cache. Never commit.
data/

# OAuth client secrets and tokens — machine credentials, never in the repo.
# They live in %USERPROFILE%\.meeting-recorder alongside the recorder env.
client_secret*.json
google_client_secret.json
token*.json
*.Zone.Identifier

# .NET (Fase 1)
recorder-net/**/bin/
recorder-net/**/obj/

# .NET (Fase 2)
app-net/**/bin/
app-net/**/obj/

# Pesos de modelo (Fase 7)
#
# Os GGUF dos motores opcionais moram ao lado do sidecar que os abre, e **nunca
# no git**: são pacotes do Nucleo/Catalogo.cs, baixados por Ajustes › Modelos, e
# o instalador também os exclui (o `.iss` exclui `*.gguf`). Durante o
# desenvolvimento esta pasta costuma ser um link para o cache de medição.
motores/*/modelos/

# O ONNX do vetor de voz é DERIVADO: o tools/medir_vetor_onnx.py o exporta do
# modelo do pyannote na primeira execução. Versioná-lo poria 25 MB no histórico
# para guardar algo que um comando reproduz.
tools/_wespeaker_resnet34.onnx

# Os grafos do Nemotron-3-Diarization, idem: tools/exportar_nemotron3_onnx.py os
# gera do checkpoint (~380 MB).
tools/_nemotron3/
__pycache__/
