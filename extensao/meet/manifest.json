{
  "manifest_version": 3,
  "name": "PulseMeet — mute do Meet e do Teams",
  "description": "Mutar no Google Meet ou no Teams pelo navegador muta a gravação do PulseMeet, e o contrário também.",
  "version": "1.1.1",
  "key": "",
  "icons": {
    "128": "icone.png"
  },
  "background": {
    "service_worker": "fundo.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://teams.live.com/*"
      ],
      "js": [
        "pagina.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ]
}
