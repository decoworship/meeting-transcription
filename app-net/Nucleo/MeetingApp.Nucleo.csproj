<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sidecar\MeetingApp.Sidecar.csproj" />
    <!-- O núcleo do gravador, desde a Fase 2.5. A dependência existe por um
         arquivo só, o PastaDasGravacoes: fundidos os dois programas, onde se
         grava e onde se lê passaram a ser a mesma configuração, e ela é a do
         gravador. Ler aquele JSON à mão, como a Fase 2 fazia, seria manter duas
         definições do mesmo formato dentro do mesmo executável. -->
    <ProjectReference Include="..\Gravacao\MeetingRecorder.Core.csproj" />
  </ItemGroup>


  <!-- Token do HuggingFace embutido no binário publicado, para quem recebe o
       app não precisar criar conta, aceitar termos de modelo e gerar token.
       O arquivo NÃO vive no repositório: o build pega o do perfil de quem
       publica, e simplesmente não embute nada se ele não estiver lá.

       Publicando do WSL, onde não há USERPROFILE, passe o caminho:
         dotnet publish ... -p:TokenHuggingFace=/mnt/c/Users/<voce>/.meeting-recorder/hf_token.txt

       ATENÇÃO: este token dá acesso à conta HuggingFace de quem publica —
       diferente do segredo OAuth do Google, que não é secreto para apps
       instalados. Use um token só de leitura, criado para isto e revogável. -->
  <PropertyGroup>
    <TokenHuggingFace Condition="'$(TokenHuggingFace)' == ''">$(USERPROFILE)\.meeting-recorder\hf_token.txt</TokenHuggingFace>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(TokenHuggingFace)')">
    <EmbeddedResource Include="$(TokenHuggingFace)" LogicalName="MeetingApp.hf_token.txt" />
  </ItemGroup>

</Project>
