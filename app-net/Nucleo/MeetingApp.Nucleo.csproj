<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sidecar\MeetingApp.Sidecar.csproj" />
    <!-- O núcleo do gravador, desde a Fase 2.5. A dependência existe por um
         arquivo só, o PastaDasGravacoes: fundidos os dois programas, onde se
         grava e onde se lê passaram a ser a mesma configuração, e ela é a do
         gravador. Ler aquele JSON à mão, como a Fase 2 fazia, seria manter duas
         definições do mesmo formato dentro do mesmo executável. -->
    <ProjectReference Include="..\Gravacao\MeetingRecorder.Core.csproj" />
  </ItemGroup>


  <!-- Token do HuggingFace embutido no binário publicado, para quem recebe o
       app não precisar criar conta, aceitar termos de modelo e gerar token.
       O arquivo NÃO vive no repositório: o build pega o do perfil de quem
       publica, e simplesmente não embute nada se ele não estiver lá.

       Publicando do WSL, onde não há USERPROFILE, passe o caminho:
         dotnet publish ... -p:TokenHuggingFace=/mnt/c/Users/<voce>/.meeting-recorder/hf_token.txt

       ATENÇÃO: este token dá acesso à conta HuggingFace de quem publica —
       diferente do segredo OAuth do Google, que não é secreto para apps
       instalados. Use um token só de leitura, criado para isto e revogável. -->
  <!-- As skills de ata, embutidas: são a instrução que o motor de ata manda ao
       modelo, e ficam dentro do binário pelo mesmo motivo da interface — um
       arquivo solto ao lado do .exe é mais uma coisa para o instalador acertar,
       e some se alguém copiar só o binário.

       Fonte única: estes arquivos são cópia de trabalho de "transcrição para
       atas/", e um teste compara os dois. Barra normal no Include, e um item
       por arquivo: com "../../assets/atas/*.md" o MSBuild rodando em Linux não
       expande o glob e o app publica sem as skills, em silêncio — foi assim que
       os ícones da bandeja sumiram uma vez. -->
  <ItemGroup>
    <EmbeddedResource Include="../../assets/atas/SKILL.md" LogicalName="MeetingApp.atas.SKILL.md" />
    <EmbeddedResource Include="../../assets/atas/cliente-update.md" LogicalName="MeetingApp.atas.cliente-update.md" />
    <EmbeddedResource Include="../../assets/atas/sprint.md" LogicalName="MeetingApp.atas.sprint.md" />
    <EmbeddedResource Include="../../assets/atas/trabalho.md" LogicalName="MeetingApp.atas.trabalho.md" />
    <EmbeddedResource Include="../../assets/atas/kickoff.md" LogicalName="MeetingApp.atas.kickoff.md" />
    <EmbeddedResource Include="../../assets/atas/resultados.md" LogicalName="MeetingApp.atas.resultados.md" />
    <EmbeddedResource Include="../../assets/atas/daily.md" LogicalName="MeetingApp.atas.daily.md" />
  </ItemGroup>

  <PropertyGroup>
    <TokenHuggingFace Condition="'$(TokenHuggingFace)' == ''">$(USERPROFILE)\.meeting-recorder\hf_token.txt</TokenHuggingFace>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(TokenHuggingFace)')">
    <EmbeddedResource Include="$(TokenHuggingFace)" LogicalName="MeetingApp.hf_token.txt" />
  </ItemGroup>

</Project>
