<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MeetingApp</AssemblyName>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Exigido pelo gerador do LibraryImport, como na bandeja. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Ver a bandeja: SelfContained só na linha de comando, para o loop de
         desenvolvimento ficar rápido. -->
    <SelfContained>false</SelfContained>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <TrimMode>partial</TrimMode>
    <NoWarn>$(NoWarn);IL2104</NoWarn>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <ApplicationIcon>..\..\assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Só o núcleo do WebView2, nunca os invólucros.
       O pacote traz Microsoft.Web.WebView2.WinForms.dll e .Wpf.dll junto, e
       referenciá-los arrastaria o framework WindowsDesktop de volta — o mesmo
       que custou 140 MB na bandeja e recusa trimming (NETSDK1175). Também
       produzia MSB3277, conflito entre duas versões de WindowsBase.
       ExcludeAssets="all" desliga a referência automática; o Reference abaixo
       traz só o Core, e o Content traz o carregador nativo. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40"
                      GeneratePathProperty="true" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll"
             Link="WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nucleo\MeetingApp.Nucleo.csproj" />
    <ProjectReference Include="..\Sidecar\MeetingApp.Sidecar.csproj" />
    <!-- O gravador, desde a Fase 2.5. Captura arrasta Gravacao (o antigo Core)
         por referência de projeto; Agenda entra explícito porque a captura não
         depende dela — quem depende é o menu, para rotular a reunião. -->
    <ProjectReference Include="..\Captura\MeetingRecorder.Capture.csproj" />
    <ProjectReference Include="..\Agenda\MeetingRecorder.Agenda.csproj" />
  </ItemGroup>

  <!-- Os ícones da bandeja, um por cor de estado, gerados pelo
       tools/gerar_icone.py. Embutidos pelo mesmo motivo da interface: um arquivo
       solto ao lado do .exe é mais uma coisa para o instalador acertar, e some
       se alguém copiar só o binário. O prefixo mudou de MeetingRecorder.Tray
       para MeetingApp junto com o assembly — ver IconesDaBandeja.

       Barra normal, e não invertida: com "..\..\assets\bandeja-*.ico" o MSBuild
       no Linux não expande o glob e não embute nada. Compila, publica, passa
       nos testes, e o app sobe sem ícone na bandeja — sem ícone não há menu, e
       sem menu não há como sair dele. É o mesmo tipo de defeito silencioso que
       o token do HuggingFace já tinha dado; a régua do publicar.sh existe
       porque este aqui foi assim que apareceu. -->
  <ItemGroup>
    <EmbeddedResource Include="../../assets/bandeja-amarelo.ico"
                      LogicalName="MeetingApp.bandeja-amarelo.ico" />
    <EmbeddedResource Include="../../assets/bandeja-cinza.ico"
                      LogicalName="MeetingApp.bandeja-cinza.ico" />
    <EmbeddedResource Include="../../assets/bandeja-laranja.ico"
                      LogicalName="MeetingApp.bandeja-laranja.ico" />
    <EmbeddedResource Include="../../assets/bandeja-vermelho.ico"
                      LogicalName="MeetingApp.bandeja-vermelho.ico" />
  </ItemGroup>

  <!-- A interface inteira vai embutida: um arquivo solto ao lado do .exe seria
       mais uma coisa para o instalador acertar, e o WebView2 serve tudo de
       memória por SetVirtualHostNameToFolderMapping ou pelo nosso handler.
       O design system vem de assets/ds. Morava em src/web/assets/ds enquanto o
       app Gradio existia e os dois precisavam da mesma cópia para não
       divergirem; o Gradio saiu em 13/08/2026 e o DS foi para junto dos outros
       ativos, que é onde ele sempre pertenceu. -->
  <!-- Sem recursão de propósito: com subpastas o %(RecursiveDir) entraria no
       nome do recurso com barras, que não é o separador que o Conteudo usa.
       Enquanto a interface couber em arquivos planos, isto é o mais simples que
       funciona — inclusive publicando do Linux, onde a barra invertida do
       MSBuild não expande glob. -->
  <ItemGroup>
    <EmbeddedResource Include="web/*.*"
                      LogicalName="MeetingApp.web.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- O design system entra sob /ds/, preservando a estrutura de pastas: os
       @font-face dele usam caminhos relativos ('fonts/Fraunces/...'), então o
       nome do recurso tem que bater com a URL que o navegador vai pedir. -->
  <ItemGroup>
    <EmbeddedResource Include="../../assets/ds/tokens/tokens.css"
                      LogicalName="MeetingApp.web.ds.tokens.tokens.css" />
    <EmbeddedResource Include="../../assets/ds/colors_and_type.css"
                      LogicalName="MeetingApp.web.ds.colors_and_type.css" />
    <EmbeddedResource Include="../../assets/ds/componentes.css"
                      LogicalName="MeetingApp.web.ds.componentes.css" />
    <EmbeddedResource Include="../../assets/ds/fonts/Fraunces/Fraunces-VariableFont.ttf"
                      LogicalName="MeetingApp.web.ds.fonts.Fraunces.Fraunces-VariableFont.ttf" />
    <EmbeddedResource Include="../../assets/ds/fonts/Fraunces/Fraunces-Italic-VariableFont.ttf"
                      LogicalName="MeetingApp.web.ds.fonts.Fraunces.Fraunces-Italic-VariableFont.ttf" />
    <EmbeddedResource Include="../../assets/ds/fonts/Hanken_Grotesk/HankenGrotesk-VariableFont_wght.ttf"
                      LogicalName="MeetingApp.web.ds.fonts.Hanken_Grotesk.HankenGrotesk-VariableFont_wght.ttf" />
    <EmbeddedResource Include="../../assets/ds/fonts/Hanken_Grotesk/HankenGrotesk-Italic-VariableFont_wght.ttf"
                      LogicalName="MeetingApp.web.ds.fonts.Hanken_Grotesk.HankenGrotesk-Italic-VariableFont_wght.ttf" />
  </ItemGroup>

</Project>
