<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MeetingRecorder</AssemblyName>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <!-- Exigido pelo gerador do LibraryImport (SYSLIB1062) e pelo ponteiro fixo
         que a IconesDaBandeja passa ao CreateIconFromResourceEx. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SelfContained>false</SelfContained>
    <!-- Ver MeetingRecorder.Cli.csproj: o WASAPI depende de COM embutido, que o
         trim completo desliga. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <TrimMode>partial</TrimMode>
    <!-- Mesma configuração do CLI, e pelo mesmo motivo: análise ligada, só o
         resumo de terceiros calado. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <ApplicationIcon>..\..\assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Os ícones entram embutidos no executável: um arquivo solto ao lado do
         .exe seria mais uma coisa para o instalador da Fase 4 acertar, e some se
         alguém copiar só o binário. Um .ico por cor de estado, gerado pelo
         tools/gerar_icone.py — substituem o tingimento em runtime com GDI+, que
         era a última dependência de System.Drawing da bandeja. -->
    <EmbeddedResource Include="..\..\assets\bandeja-*.ico"
                      LogicalName="MeetingRecorder.Tray.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Capture\MeetingRecorder.Capture.csproj" />
    <ProjectReference Include="..\Agenda\MeetingRecorder.Agenda.csproj" />
  </ItemGroup>

</Project>
