<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MeetingRecorder</AssemblyName>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SelfContained>false</SelfContained>
    <!-- Ver MeetingRecorder.Cli.csproj: o WASAPI depende de COM embutido, que o
         trim completo desliga. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <ApplicationIcon>..\..\assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- O logo entra embutido no executável: um arquivo solto ao lado do .exe
         seria mais uma coisa para o instalador da Fase 4 acertar, e some se
         alguém copiar só o binário. -->
    <EmbeddedResource Include="..\..\assets\logo-256.png"
                      LogicalName="MeetingRecorder.Tray.logo-256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Capture\MeetingRecorder.Capture.csproj" />
    <ProjectReference Include="..\Agenda\MeetingRecorder.Agenda.csproj" />
  </ItemGroup>

</Project>
